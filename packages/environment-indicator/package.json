{
  "name": "@kitaris/emdash-environment-indicator",
  "version": "0.0.0",
  "description": "An EmDash plugin that shows which environment a site is (development, staging or production) on the dashboard.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtnorth/emdash-plugins.git",
    "directory": "packages/environment-indicator"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "environment",
    "staging"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "@emdash-cms/blocks": "^1.3.0",
    "emdash": "^1.3.0"
  },
  "devDependencies": {
    "@emdash-cms/blocks": "1.3.1",
    "emdash": "1.3.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      }
    }
  }
}
